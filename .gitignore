## Ignore Visual Studio temporary files, build results, and
## project-specific user settings.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent.log

# Output of the build results
[Ss]pecRun.*.html

# Visual Studio Profiling tool
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Code project settings
.vscode/

# Logic-less templates
*.t4

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# If using the old MSBuild-integrated restore, the intermediate
# .nuget directory can be excluded.
!.nuget/

# Microsoft Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Cloud Service projects
*.cache
*.cscfg
*.csdef
*.pubxml
*.publishsettings

# Others
sql/
*.Cache
ClientBin/
[Ss]tyle[Cc]op.*
~$*
*~
*.dbmdl
*.dbproj.user
*.publish.xml
*.pot
*.vshost.exe
*.vshost.exe.config
*.vshost.exe.manifest
*.xml
*.log
*.tmp
*.temp

# ReSharper is a 3rd party add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode is a 3rd party add-in
.JustCode

# TeamCity is a build server
_TeamCity*

# DotCover is a 3rd party add-in
*.dotCover

# AxoCover is a 3rd party add-in
.axoCover/*
!.axoCover/settings.json

# Coverlet is a 3rd party add-in
coverage.json
coverage.cobertura.xml
coverage.info

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# WebAdvisor
URL_List.txt

# Navigation bar cache
*.nav

# GitHub tool
*.ghcache

# Quattra tool
*.Quattra

# NNCache tool
*.nncache

# GhostDoc tool
*.GhostDoc.xml

# Visual Studio 2015 Analyzer
GhostDocTimer.txt

# JetBrains Rider
.idea/
*.sln.iml

# SonarLint for Visual Studio
.sonarlint/

# Visual Studio 2017/2019 Code Analysis folders
<CodeAnalysisDictionary>.xml
_AnalysisConfig/

# Backup and restore files from Wix
Backup/

# StyleCop
StyleCop.Cache

# Cake
Tools/
_ReSharper.Caches/

# Rider
.idea/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini